# Copy this file to the project root as ".env" and fill it in. Never commit .env.
#
# ONLY THE FIRST LINE IS REQUIRED. Everything below it is for translating the
# attached PDF, which ships disabled (translation.provider: "none" in
# settings.yaml). Those variables are never read while it stays that way, so an
# installation is done once GEMINI_API_KEY has a value.

GEMINI_API_KEY=

# =============================================================================
# Everything below is OPTIONAL. Leave it untouched unless you switch
# translation.provider away from "none" in config/settings.yaml.
# =============================================================================

# provider: "google" — billed per page (~USD 0.08). Needs a Cloud project with
# billing enabled and a service account with the "Cloud Translation API User"
# role.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# provider: "deepl" — bills a 50,000-character minimum per file, roughly 16x the
# real content of these reports. Keys ending in ":fx" belong to the Free plan,
# whose terms forbid submitting confidential data; the application refuses to
# start with one unless DEEPL_ALLOW_FREE_KEY is true.
DEEPL_API_KEY=
DEEPL_ALLOW_FREE_KEY=false
