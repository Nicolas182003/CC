# Copy this file to the project root as ".env" and fill it in. Never commit .env.

# --- REQUIRED: phrase translation --------------------------------------------
# Key from https://aistudio.google.com/apikey — free and needs no credit card.
# This is what translates the report's phrases into the email body, and it is the
# default (glossary.phrase_provider: "gemini" in settings.yaml).
GEMINI_API_KEY=

# --- OPTIONAL: translating the attached PDF ----------------------------------
# Only the block matching translation.provider in settings.yaml is needed, and
# only if that provider is not "none".

# --- provider: google (recommended) ------------------------------------------
# Project id from the Google Cloud console.
GOOGLE_CLOUD_PROJECT=
# Absolute path to the service account JSON key with the
# "Cloud Translation API User" role.
GOOGLE_APPLICATION_CREDENTIALS=

# --- provider: deepl ---------------------------------------------------------
# Keys ending in ":fx" belong to the API Free plan, whose terms forbid submitting
# confidential data. The application refuses to start with one unless
# DEEPL_ALLOW_FREE_KEY is true (only for testing with synthetic PDFs).
DEEPL_API_KEY=
DEEPL_ALLOW_FREE_KEY=false
